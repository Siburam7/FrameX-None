# Backend secrets, local database and dependencies never go to Git.
backend/.env
backend/.env.*
!backend/.env.example
backend/.data/
backend/node_modules/
node_modules/
*.log

# Home Decor image build: downloaded source paintings and scratch files
tools/decor/sources/
tools/decor/.tmp/

# Safety copies of the local database made before an upgrade (they hold real accounts and orders)
backend/.data.backup-*/
