# FrameX backend — example environment file.
# Copy to ".env" and fill in real values. NEVER commit ".env".
# Every value below is a placeholder. After changing ".env", restart the backend.
# Check what is and isn't configured at any time with:  npm run doctor

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Leave EMPTY for local development: the server
# then uses an embedded Postgres (PGlite) stored in backend/.data/pg.
# Production: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# Set to "require" for hosted Postgres that needs TLS (Neon, Render, Supabase...).
DATABASE_SSL=

# --- Authentication -------------------------------------------------------
# Long random string (32+ characters). Required in production. It keys the
# hashes of sessions, reset links and one-time codes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string
SESSION_TTL_DAYS=14
# Cookie settings. "lax" works when the website and the API share a site
# (localhost, or example.com + api.example.com). Use "none" (with HTTPS) only if
# the API is on a different site and you accept third-party-cookie limits.
COOKIE_SAMESITE=lax
# Also return the session token in the login response so a website on a
# different site (e.g. *.github.io calling *.onrender.com) can send it as
# "Authorization: Bearer". Leave false when cookies work.
AUTH_ALLOW_BEARER=false

# --- Website / CORS -------------------------------------------------------
# The website's public address, WITHOUT a trailing slash. Password-reset and
# shop-setup links in emails are built from it:
#   <FRONTEND_URL>/reset-password.html#token=...
# Production: REQUIRED, e.g. https://siburam7.github.io/FrameX-None
# Local: leave empty; links then point back at the allowed address the request
# came from (http://localhost:4000 or Live Server on :5500).
FRONTEND_URL=
# Comma-separated list of website origins allowed to call the API
# (origin = scheme + host, no path), e.g. https://siburam7.github.io
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Serve the website files from this server too (handy locally).
SERVE_FRONTEND=true
# Number of reverse proxies in front of the server (1 on Render/Railway/Fly).
TRUST_PROXY=0

# --- Email (password-reset codes and links, shop-setup links) --------------
# Nothing is sent until a provider is configured. With no provider the website
# says "Email service is not configured." — there is no silent fallback.
#
#   brevo  = Brevo transactional email API (recommended; free plan available)
#            needs EMAIL_PROVIDER_API_KEY and EMAIL_FROM
#   resend = Resend API. Needs EMAIL_PROVIDER_API_KEY and EMAIL_FROM
#            (Resend only sends from a domain you own and have verified)
#   gmail  = a Gmail account + Google App Password (GMAIL_* below).
#            Fill it in with "npm run email:setup". Low volume only.
#   smtp   = any other SMTP server (SMTP_* below)
#   none   = email is off
#   dev    = TEST MODE, development only: nothing is sent, messages are kept at
#            http://localhost:4000/dev/mailbox and the website shows a striped
#            "Development mode: nothing was really sent" notice. Refused in production.
EMAIL_PROVIDER=brevo
# Brevo: https://app.brevo.com → your name (top right) → SMTP & API → API keys.
EMAIL_PROVIDER_API_KEY=
# The sender. The address must be verified with the provider
# (Brevo: Senders, Domains & Dedicated IPs → Senders → Add a sender).
EMAIL_FROM="FrameX <support@example.com>"
# Optional: where replies go.
EMAIL_REPLY_TO=
# Only for EMAIL_PROVIDER=gmail: the address and a 16-letter Google "App
# Password" (NOT the normal password): https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Only for EMAIL_PROVIDER=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: address that is told about new shop applications.
ADMIN_NOTIFY_EMAIL=

# --- SMS (password-reset codes to a mobile number) -------------------------
# Nothing is sent until a provider is configured. With no provider the website
# says "SMS service is not configured."
#
#   fast2sms = Fast2SMS (India). Needs SMS_API_KEY and wallet credit.
#              Without SMS_SENDER_ID / SMS_TEMPLATE_ID it uses Fast2SMS's own
#              OTP route (no DLT registration of your own needed).
#              With both set it uses your DLT-approved sender and template.
#   2factor  = 2Factor.in (India). Needs SMS_API_KEY; SMS_TEMPLATE_ID is the
#              name of your approved OTP template (optional).
#   twilio   = Twilio (TWILIO_* below). Sending to India needs DLT registration.
#   none     = SMS is off
#   dev      = TEST MODE, development only (same rules as EMAIL_PROVIDER=dev)
SMS_PROVIDER=fast2sms
# Fast2SMS: https://www.fast2sms.com → Dev API → API key.
SMS_API_KEY=
# Optional, for your own DLT registration (6-letter header and template id).
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
# Only for SMS_PROVIDER=twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- One-time codes (defaults shown; change only if you need to) ------------
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_MAX_PER_HOUR=5

# --- Location -------------------------------------------------------------
# nominatim = OpenStreetMap place search (free, low volume, needs a contact email)
# none      = no place search; manual location falls back to text matching
GEOCODER_PROVIDER=nominatim
GEOCODER_CONTACT_EMAIL=you@example.com
# Reserved for a future map / geocoding provider (Google Maps, Mapbox...).
MAP_PROVIDER_KEY=
NEARBY_DEFAULT_RADIUS_KM=25
NEARBY_RADIUS_OPTIONS_KM=5,10,25,50
