# FrameX backend — example environment file.
# Copy to ".env" and fill in real values. NEVER commit ".env".
# Every value below is a placeholder. After changing ".env", restart the backend.
# Check what is and isn't configured at any time with:  npm run doctor

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Leave EMPTY for local development: the server
# then uses an embedded Postgres (PGlite) stored in backend/.data/pg.
# Production: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# Set to "require" for hosted Postgres that needs TLS (Neon, Render, Supabase...).
DATABASE_SSL=

# --- Authentication -------------------------------------------------------
# Long random string (32+ characters). Required in production. It keys the
# hashes of sessions, reset links and one-time codes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string
SESSION_TTL_DAYS=14
# Cookie settings. "lax" works when the website and the API share a site
# (localhost, or example.com + api.example.com). Use "none" (with HTTPS) only if
# the API is on a different site and you accept third-party-cookie limits.
COOKIE_SAMESITE=lax
# Also return the session token in the login response so a website on a
# different site (e.g. *.github.io calling *.onrender.com) can send it as
# "Authorization: Bearer". Leave false when cookies work.
AUTH_ALLOW_BEARER=false

# --- Website / CORS -------------------------------------------------------
# The website's public address, WITHOUT a trailing slash. Password-reset and
# shop-setup links in emails are built from it:
#   <FRONTEND_URL>/reset-password.html#token=...
# Production: REQUIRED, e.g. https://siburam7.github.io/FrameX-None
# Local: leave empty; links then point back at the allowed address the request
# came from (http://localhost:4000 or Live Server on :5500).
FRONTEND_URL=
# Comma-separated list of website origins allowed to call the API
# (origin = scheme + host, no path), e.g. https://siburam7.github.io
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Serve the website files from this server too (handy locally).
SERVE_FRONTEND=true
# Folder that holds the website's "js" and "assets/js" folders. The server imports
# the catalogue from them and uses the website's own pricing code for the cart.
# Leave empty when the backend is deployed with the whole project (the default).
CATALOG_DIR=
# Number of reverse proxies in front of the server (1 on Render/Railway/Fly).
TRUST_PROXY=0

# --- Email (password-reset codes and links, shop-setup links) --------------
# Nothing is sent until a provider is configured. With no provider the website
# says "Email service is not configured." — there is no silent fallback.
#
#   brevo  = Brevo transactional email API (recommended; free plan available)
#            needs EMAIL_PROVIDER_API_KEY and EMAIL_FROM
#   resend = Resend API. Needs EMAIL_PROVIDER_API_KEY and EMAIL_FROM
#            (Resend only sends from a domain you own and have verified)
#   gmail  = a Gmail account + Google App Password (GMAIL_* below).
#            Fill it in with "npm run email:setup". Low volume only.
#   smtp   = any other SMTP server (SMTP_* below)
#   none   = email is off
#   dev    = TEST MODE, development only: nothing is sent, messages are kept at
#            http://localhost:4000/dev/mailbox and the website shows a striped
#            "Development mode: nothing was really sent" notice. Refused in production.
EMAIL_PROVIDER=brevo
# Brevo: https://app.brevo.com → your name (top right) → SMTP & API → API keys.
EMAIL_PROVIDER_API_KEY=
# The sender. The address must be verified with the provider
# (Brevo: Senders, Domains & Dedicated IPs → Senders → Add a sender).
EMAIL_FROM="FrameX <support@example.com>"
# Optional: where replies go.
EMAIL_REPLY_TO=
# Only for EMAIL_PROVIDER=gmail: the address and a 16-letter Google "App
# Password" (NOT the normal password): https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Only for EMAIL_PROVIDER=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: the address that is told about new shop and artist applications and that
# receives the messages sent from the Contact page. Empty = Contact messages go to the
# email of every admin account. Several addresses: separate them with a comma.
ADMIN_NOTIFY_EMAIL=
# Contact page: at most this many alert emails an hour (more messages than that stay in
# admin -> Messages without an email, so a flood can't use up the email allowance).
CONTACT_ALERTS_PER_HOUR=30

# --- SMS (password-reset codes to a mobile number) -------------------------
# Nothing is sent until a provider is configured. With no provider the website
# says "SMS service is not configured."
#
#   fast2sms = Fast2SMS (India). Needs SMS_API_KEY and wallet credit.
#              Without SMS_SENDER_ID / SMS_TEMPLATE_ID it uses Fast2SMS's own
#              OTP route (no DLT registration of your own needed).
#              With both set it uses your DLT-approved sender and template.
#   2factor  = 2Factor.in (India). Needs SMS_API_KEY; SMS_TEMPLATE_ID is the
#              name of your approved OTP template (optional).
#   twilio   = Twilio (TWILIO_* below). Sending to India needs DLT registration.
#   none     = SMS is off
#   dev      = TEST MODE, development only (same rules as EMAIL_PROVIDER=dev)
SMS_PROVIDER=fast2sms
# Fast2SMS: https://www.fast2sms.com → Dev API → API key.
SMS_API_KEY=
# Optional, for your own DLT registration (6-letter header and template id).
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
# Only for SMS_PROVIDER=twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Online payments -----------------------------------------------------
# Nothing can be paid online until a gateway is configured. Checkout then
# offers Cash on Delivery only (if it is on) and says online payment isn't
# available. The key secret and the webhook secret stay on the server: they
# are never sent to a browser and must never be committed.
#
#   cashfree = Cashfree Payments (UPI, cards, net banking, wallets) - the gateway FrameX uses
#   razorpay = Razorpay (kept as a second adapter behind the same code)
#   none     = online payment is off
PAYMENT_PROVIDER=none
# test = sandbox / test credentials: no real money moves.
# live = production credentials: real payments. Needs an activated account.
# Test credentials in live mode (or the other way round) are refused.
PAYMENT_MODE=test

# Cashfree: Merchant Dashboard -> Developers -> API Keys (switch the dashboard
# to "Test" for sandbox credentials). The App ID is the client id.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2025-01-01
# Cashfree Dashboard -> Developers -> Webhooks -> Add Webhook Endpoint:
#   URL     https://<your backend address>/api/payments/webhook/cashfree
#   Events  Payment success, Payment failed, Payment user dropped, Refund
# Cashfree signs webhooks with the API secret above. Only fill this in if your
# account gives the webhook its own secret.
CASHFREE_WEBHOOK_SECRET=
# The backend's own public address (https://api.example.com). When it is set,
# each Cashfree order is also told to send its webhook there.
PUBLIC_API_URL=

# Razorpay Dashboard -> Account & Settings -> API Keys -> Generate Test Key.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Account & Settings -> Webhooks -> Add New Webhook:
#   URL     https://<your backend address>/api/payments/webhook/razorpay
#   Secret  any long random text; put the same text here
#   Events  payment.authorized, payment.captured, payment.failed, order.paid,
#           refund.created, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=
# An online order that is not paid within this many minutes is cancelled and
# its stock is given back.
PAYMENT_PENDING_MINUTES=30

# --- Custom paintings (Art & Artists) -------------------------------------
# The part of a custom painting's price the customer pays once the artist has
# accepted, in percent. The rest is paid when the painting is finished. A
# FrameX admin can change it in the dashboard (Settings); this is the default.
CUSTOM_PAINTING_ADVANCE_PERCENT=40
# An accepted request waits this many days for its advance, then is closed.
CUSTOM_PAINTING_ADVANCE_DAYS=7
# FrameX's share of a sale in percent. Recorded for reports only: payouts to
# shops and artists are not automated.
PLATFORM_COMMISSION_PERCENT=0

# --- Checkout: what the server adds to an order (whole rupees) -------------
# These are YOUR prices and rules: set them before taking real orders.
# Tax added on top of item prices, in percent. 0 = your prices already include tax.
TAX_PERCENT=0
# Delivery charge per order, and the order value from which delivery is free
# (0 = the delivery charge always applies).
SHIPPING_FEE=0
SHIPPING_FREE_ABOVE=0
# Cash on Delivery: on/off, an extra fee, the highest order value it is
# offered for (0 = no limit), and where / for what it is not offered.
COD_ENABLED=true
COD_FEE=0
COD_MAX_ORDER_VALUE=0
# PIN codes or their first digits, comma separated (e.g. 7999,110001).
COD_BLOCKED_PINCODES=
# Catalogue shop ids and product ids, comma separated (e.g. shop-003  /  p-012,p-017).
COD_BLOCKED_SHOPS=
COD_BLOCKED_PRODUCTS=
# false = personalised FrameX Studio designs must be paid online.
COD_ALLOW_CUSTOM_DESIGNS=true

# --- Gift wrapping --------------------------------------------------------
# Checkout asks "Would you like to gift wrap this order?". The charge is per
# order (whole rupees) and is shown as its own line before the customer pays.
# THIS IS YOUR PRICE: set it before taking real orders. 0 = offered for free.
GIFT_WRAP_ENABLED=true
GIFT_WRAP_FEE=49
# Where it is not offered: catalogue shop ids / product ids, comma separated.
# A shop can also switch it off for itself (shop dashboard -> Profile) and for
# a single product (product editor). If any item in an order can't be wrapped,
# the question is shown switched off with the reason.
GIFT_WRAP_BLOCKED_SHOPS=
GIFT_WRAP_BLOCKED_PRODUCTS=

# --- Customer photos (the originals that orders are printed from) ----------
# Photos are stored exactly as uploaded: never resized, re-encoded or
# "enhanced". They are private: there is no public address for them. A photo
# is only sent through a signed link that lasts UPLOAD_LINK_SECONDS, and such
# a link is only made for the customer, FrameX staff, and the shop that has to
# make that order line.
#
# Folder the files are kept in. Leave empty for backend/.data/uploads.
# PRODUCTION: this must be a disk that survives restarts and redeploys (on
# Render: a persistent disk, e.g. /var/data/uploads). On a host without one,
# uploaded photos are LOST when the service restarts.
UPLOAD_DIR=
# Largest photo accepted, in MB (1-200). 50 covers 4K and most camera JPEGs.
UPLOAD_MAX_MB=50
# How long a download link works, in seconds (30-3600).
UPLOAD_LINK_SECONDS=300
# Photos one account may have waiting that are not in an order yet.
UPLOAD_MAX_WAITING=80
# A photo that never reached an order (and is in no cart) is deleted after
# this many days. Photos that are part of an order are always kept.
UPLOAD_UNUSED_DAYS=30

# --- Analytics (admin dashboard) ---------------------------------------------
# Sales, orders, payments and accounts in the admin dashboard always come from
# the database. These settings are about VISITOR statistics only.
# true  = the website may send page / product / search statistics for visitors
#         who pressed "Allow analytics" in its banner. false = none are collected
#         and the banner is not shown (unless GA4 below is set).
ANALYTICS_ENABLED=true
# Google Analytics 4 (optional). The Measurement ID of your GA4 web data stream,
# e.g. G-AB12CD34EF (GA4 -> Admin -> Data streams). Leave empty to not use GA4.
# It is loaded only after a visitor allows analytics. It is not a secret.
GA4_MEASUREMENT_ID=
# Visitor and login records older than this many days are deleted (30-1825).
ANALYTICS_RETENTION_DAYS=400
# The reports' calendar day, as minutes ahead of UTC. 330 = India (UTC+5:30).
ANALYTICS_UTC_OFFSET_MINUTES=330
# A cart with items that nobody touched for this many hours counts as abandoned.
ANALYTICS_ABANDONED_CART_HOURS=24

# --- Shop products ---------------------------------------------------------
# Shops add their own products from the shop dashboard.
# true  = a shop's first "Publish" waits until FrameX approves it in the admin
#         panel (Products). false = it goes on sale straight away; FrameX can
#         still take any product off sale.
PRODUCT_MODERATION=false
# Largest product picture, in MB (1-40), and how many pictures one shop may keep.
MEDIA_MAX_MB=12
MEDIA_MAX_PER_SHOP=600

# --- One-time codes (defaults shown; change only if you need to) ------------
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_MAX_PER_HOUR=5

# --- Location -------------------------------------------------------------
# nominatim = OpenStreetMap place search (free, low volume, needs a contact email)
# none      = no place search; manual location falls back to text matching
GEOCODER_PROVIDER=nominatim
GEOCODER_CONTACT_EMAIL=you@example.com
# Reserved for a future map / geocoding provider (Google Maps, Mapbox...).
MAP_PROVIDER_KEY=
NEARBY_DEFAULT_RADIUS_KM=25
NEARBY_RADIUS_OPTIONS_KM=5,10,25,50
